rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public profile: username + optional avatar URL, no phone number
    // (Firebase Auth already owns that, and it's never written here).
    // Readable by any signed-in user so group members/search can resolve
    // usernames; writable only by the owner. Usernames are immutable once
    // created — changing one would need to release the old usernames/{lower}
    // doc too, which isn't implemented yet — but photoURL can be updated any
    // time.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.usernameLower == request.resource.data.username.lower();
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
        && request.resource.data.photoURL is string;
      allow delete: if false;
    }

    // Reservation lock keyed by lowercased username, doc id enforces global
    // uniqueness via Firestore's create-only-if-absent semantics.
    match /usernames/{usernameLower} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Communities are open/discoverable — any signed-in user can read and
    // join. Membership changes are restricted to adding/removing only your
    // own uid (one at a time), so no one can add/remove someone else's
    // membership. Only the owner can edit name/description, and never via
    // the same write as a membership change.
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40;
      allow update: if request.auth != null && (
        (resource.data.ownerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'ownerId']))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) && (
          (request.auth.uid in request.resource.data.memberIds
            && !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
          ||
          (!(request.auth.uid in request.resource.data.memberIds)
            && request.auth.uid in resource.data.memberIds
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)
        ))
      );
      allow delete: if false;
    }
  }
}
